#!/bin/sh
set -eu
[ "$#" -eq 2 ] || exit 71
[ "$1" = origin ] || exit 72
[ "$2" = https://github.com/theislampill/IMPLEMENTAUDIT.md.git ] || exit 73
count=0
while read -r local_ref local_oid remote_ref remote_oid
 do
  count=$((count + 1))
  [ "$count" -eq 1 ] || exit 74
  [ "$local_oid" = ce144b1d06f81bda3225b48d3bab32374515cff5 ] || exit 75
  [ "$remote_ref" = refs/heads/pro/dg16-r5-full-g2-direct-host-20-20261114 ] || exit 76
  [ "$remote_oid" = 0000000000000000000000000000000000000000 ] || exit 77
 done
[ "$count" -eq 1 ] || exit 78
printf '%s\n' 'PR255 exact candidate/expected-head/sole-ref guard passed; non-force transport required' >&2
