+def selected_v3_candidates(policy, run_root):
+    """Pre-authorized kinds in fixed order; the lifecycle owner decides which holds."""
+    rows = policy.get("dispositions")
+    order = ["NONTERMINAL_YIELD", "AUDITED_HANDOFF", "TERMINAL_CLOSURE"]
+    if not isinstance(rows, list) or not rows or len(rows) > 3:
+        raise InterlockUnavailable("v3 policy requires 1-3 pre-authorized dispositions")
+    result = []
+    for row in rows:
+        kind, pin = selected_disposition({"schema": "implementaudit.codex-stop-policy.v2", "disposition": row}, run_root)
+        result.append((kind, pin))
+    kinds = [k for k, _ in result]
+    if len(set(kinds)) != len(kinds):
+        raise InterlockUnavailable("v3 policy repeats a disposition")
+    return sorted(result, key=lambda item: order.index(item[0]))
