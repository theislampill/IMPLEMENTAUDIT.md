+def m6_blanket_deferral_controls(root, scratch):
+    """R35-L05.c: an unrelated authority hold cannot blanket-block preparation."""
+    current = graph(root)
+    transition = wg.compile_recursive_transition_v1(current, [])
+    assert transition["selected"] == ["PREP", "SIB"]
+    assert "AUTHORIZATION" in transition["blocked"]["ADMIT"]
+    assert all(by_id(current)[name]["authorization"] == "PERMITTED"
+               and name not in transition["blocked"] for name in transition["selected"])
+    frozen = raw(current)
+    scratch.mkdir(parents=True)
+    executions, consumptions = [], []
+    for name in transition["selected"]:
+        out = scratch / (name + ".json")
+        code = execute_manifest(root, current, transition, name, out)
+        execution, consumption = consume_manifest(root, current, transition, name, out, code)
+        executions.append(execution)
+        consumptions.append(consumption)
+    accepted = wg.check_recursive_execution_v1(current, [], transition, executions, consumptions)
+    assert accepted["status"] == "PORTABLE_RECORDS_CONSUMED"
+    assert accepted["consumed"] == ["PREP", "SIB"] and accepted["authority"] == "NONE"
+    # Keep the real graph, event, capacity and every original block unchanged.
+    # This well-sealed claim borrows ADMIT's actual authority gate for every
+    # selected independent cell; the original source does not support it.
+    blanket = copy.deepcopy(transition)
+    for name in transition["selected"]:
