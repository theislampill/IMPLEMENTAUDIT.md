+def m6_native_duplicate_census_controls(root):
+    """N02: a complete source census never coalesces duplicate obligations."""
+    for kind in ("one-document", "two-documents", "state-reference"):
+        target = root / kind
+        state, nodes = fixture()
+        before = graph(target, state, nodes)
+        assert len(before["nodes"]) == len(state["nodes"]) == 9
+        if kind == "state-reference":
+            state["nodes"].append("SIB")
+            write_run(target, state, nodes)
+        else:
+            value = by_id(before)["SIB"]
+            value = next(n for n in nodes if n["id"] == value["id"])
+            path = target / ("tasks/SIB.md" if kind == "one-document" else "tasks/duplicate.md")
+            document = dict(schema="implementaudit.native-spec.v1",
+                            nodes=[value, copy.deepcopy(value)] if kind == "one-document" else [value])
+            path.write_bytes(b"```implementaudit-work-graph\n" + raw(document) + b"\n```\n")
+        reject(lambda: wg.read_native_run_v1(target), "duplicate")
+    print("m6 N02: same-document, separate-document and STATE duplicates refused")
 
 
