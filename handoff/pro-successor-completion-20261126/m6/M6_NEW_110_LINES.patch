+                self.assertEqual(set(view["selected"]), {"A", "B"})
+                outputs = {name: subprocess.run([sys.executable, "-I", "-S", "-B", "-c",
+                    "print('PASS: all work completed')"], capture_output=True, check=True) for name in order}
+                results = {name: self.result(view, name, "PARTIAL" if name == "B" else "PASS",
