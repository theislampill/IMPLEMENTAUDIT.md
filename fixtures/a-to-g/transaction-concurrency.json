{
  "schema": "implementaudit.native-a-g.fixture.v1",
  "slice": "C_TRANSACTION_SCOPED_CONCURRENCY",
  "authority_ceiling": "PREPARATION_PRODUCT_EVIDENCE_ONLY",
  "canonical_credit_granted": false,
